# NSAttributeType numbers as Xcode 27 momc writes them (Float=600, Decimal=400 as observed).
ATTR_TYPES = {
    "Integer 16": 100, "Integer 32": 200, "Integer 64": 300,
    "Decimal": 400, "Double": 500, "Float": 600,
    "String": 700, "Boolean": 800, "Date": 900,
    "Binary": 1000, "UUID": 1100, "URI": 1200, "Transformable": 1800,
}
ATTR_CLASSES = {
    100: "NSNumber", 200: "NSNumber", 300: "NSNumber", 400: "NSDecimalNumber",
    500: "NSNumber", 600: "NSNumber", 700: "NSString", 800: "NSNumber",
    900: "NSDate", 1000: "NSData", 1100: "NSUUID", 1200: "NSURL",
}
DELETE_RULES = {"no action": 0, "nullify": 1, "cascade": 2, "deny": 3}

